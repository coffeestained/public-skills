          "kind": "list",
          "title": "List frames",
          "ordered": true,
          "items": [
            "`router.ts` validates the layer.",
            "`frames.ts` asks the repository for the newest run whose status is complete.",
            "It builds one URL per frame from the run's prefix.",
            "The response is cacheable for 60 seconds."
          ]
        },
        {
          "kind": "list",
          "title": "Rules that always hold",
          "items": [
            "A run that is not complete is never returned.",
            "A handler reaches AWS or NWS only through its adapter.",
            "No request is logged with its coordinates."
          ]
        }
      ]
